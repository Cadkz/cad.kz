# Скопируйте в .env (файл не попадает в git) и заполните. Секреты сюда не вписывать.
DATABASE_URL=
PAYLOAD_SECRET=
APP_MODE=demo
# Адрес сайта для карты сайта и канонических ссылок. На рабочем сайте: https://cad.kz
SITE_URL=

# Где хранить картинки CMS: пусто или local — папка media на этом компьютере, blob — Vercel Blob.
# При blob нужен BLOB_READ_WRITE_TOKEN (на Vercel его добавляет подключённое хранилище Blob).
MEDIA_STORAGE=
BLOB_READ_WRITE_TOKEN=

# migrate — таблицы меняют только миграции (для базы на хостинге). Пусто — Payload подгоняет их сам (локально).
DB_SCHEMA_MODE=

# Первый администратор: нужен только для команды pnpm demo:setup, потом удалить из .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ИИ-консультант Кадди. anthropic — модель Claude (нужен MODEL_API_KEY, ключ API компании с месячным
# лимитом расходов); demo — без модели: Кадди честно пишет, что ИИ не подключён, и ищет по каталогу;
# off — выключен (Кадди в углу не показывается). Пусто — demo в демоверсии сайта (APP_MODE=demo), иначе выключен.
MODEL_PROVIDER=
MODEL_API_KEY=
# Модель; пусто — claude-haiku-5-5 (быстрая и недорогая). Умнее и дороже — claude-sonnet-5-5.
MODEL_NAME=
# Битрикс24: адрес входящего вебхука (права CRM и «Пользователи»), вида https://<портал>/rest/<id>/<ключ>/.
# Пусто — заявки и заказы сохраняются на сайте, но в Битрикс24 не уходят (честная пометка «демоверсия»).
# В демоверсии (APP_MODE=demo) лиды приходят с пометкой «ТЕСТ сайта» в названии. Проверка — админка → «Битрикс24».
BITRIX24_WEBHOOK_URL=
# ID пользователя Битрикс24, на которого ставить лиды (число из адреса профиля). Пусто — решает Битрикс24.
BITRIX24_RESPONSIBLE_ID=
# Открытая линия для Кадди: локальное серверное приложение портала Битрикс24 (права imopenlines,
# imconnector, im). Код и ключ приложения — со страницы приложения в Битрикс24. Пусто — разговоры
# с Кадди в открытую линию не идут. Установка и подключение — docs/HANDOFF.md, раздел «Открытая линия».
BITRIX24_APP_CLIENT_ID=
BITRIX24_APP_CLIENT_SECRET=
