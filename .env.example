# Скопируйте в .env (файл не попадает в git) и заполните. Секреты сюда не вписывать.
DATABASE_URL=
PAYLOAD_SECRET=
APP_MODE=demo

# Где хранить картинки CMS: пусто или local — папка media на этом компьютере, blob — Vercel Blob.
# При blob нужен BLOB_READ_WRITE_TOKEN (на Vercel его добавляет подключённое хранилище Blob).
MEDIA_STORAGE=
BLOB_READ_WRITE_TOKEN=

# migrate — таблицы меняют только миграции (для базы на хостинге). Пусто — Payload подгоняет их сам (локально).
DB_SCHEMA_MODE=

# Первый администратор: нужен только для команды pnpm demo:setup, потом удалить из .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

MODEL_PROVIDER=
MODEL_API_KEY=
BITRIX24_WEBHOOK_URL=
