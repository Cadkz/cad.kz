# Скопируйте в .env (файл не попадает в git) и заполните. Секреты сюда не вписывать.
DATABASE_URL=
PAYLOAD_SECRET=
APP_MODE=demo
# Адрес сайта для карты сайта и канонических ссылок. На рабочем сайте: https://cad.kz
SITE_URL=

# Где хранить картинки CMS: пусто или local — папка media на этом компьютере, blob — Vercel Blob.
# При blob нужен BLOB_READ_WRITE_TOKEN (на Vercel его добавляет подключённое хранилище Blob).
MEDIA_STORAGE=
BLOB_READ_WRITE_TOKEN=

# migrate — таблицы меняют только миграции (для базы на хостинге). Пусто — Payload подгоняет их сам (локально).
DB_SCHEMA_MODE=

# Первый администратор: нужен только для команды pnpm demo:setup, потом удалить из .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ИИ-консультант Кади. anthropic — модель Claude (нужен MODEL_API_KEY, ключ API компании с месячным
# лимитом расходов); demo — без модели: Кади честно пишет, что ИИ не подключён, и ищет по каталогу;
# off — выключен (Кади в углу не показывается). Пусто — demo в демоверсии сайта (APP_MODE=demo), иначе выключен.
MODEL_PROVIDER=
MODEL_API_KEY=
# Модель; пусто — claude-haiku-5-5 (быстрая и недорогая). Умнее и дороже — claude-sonnet-5-5.
MODEL_NAME=
BITRIX24_WEBHOOK_URL=
